rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /fichas/{documento} {
      allow read, write: if request.auth != null;
    }

    match /meta/{documento} {
      allow read, write: if request.auth != null;
    }

    match /ingredientes/{documento} {
      allow read, write: if request.auth != null;
    }

    match /recetas/{documento} {
      allow read, write: if request.auth != null;
    }

  }
}
